# Required: copy this file to .env and change these before running.
PEBBLE_PASSWORD=your-password-here
PEBBLE_JWT_SECRET=your-random-secret-at-least-32-chars

# Optional
PEBBLE_DATA_DIR=/data
PEBBLE_PORT=8080
PEBBLE_SYNC_INTERVAL=300
PEBBLE_ENCRYPTION_KEY=

# Public base URL used to build OAuth redirect URIs.
# Must match the URL users open in the browser (scheme + host + port).
# Example: https://mail.example.com  or  http://localhost:8080
PEBBLE_PUBLIC_URL=http://localhost:8080

# Google OAuth (Gmail) — create a Web application client and add redirect URI:
#   {PEBBLE_PUBLIC_URL}/api/v1/oauth/callback
# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth (Outlook) — register a Web or SPA app and add redirect URI:
#   {PEBBLE_PUBLIC_URL}/api/v1/oauth/callback
# https://entra.microsoft.com/
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# Optional for confidential/web clients:
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
