# Required: copy this file to .env and change these before running.
PEBBLE_PASSWORD=your-password-here
PEBBLE_JWT_SECRET=your-random-secret-at-least-32-chars

# Optional
PEBBLE_DATA_DIR=/data
PEBBLE_PORT=8080
PEBBLE_REALTIME_PREFERENCE=balanced
PEBBLE_ENCRYPTION_KEY=

# Optional OAuth (callback: <PEBBLE_PUBLIC_BASE_URL>/api/v1/oauth/{gmail,outlook}/callback)
PEBBLE_PUBLIC_BASE_URL=
PEBBLE_GOOGLE_CLIENT_ID=
PEBBLE_GOOGLE_CLIENT_SECRET=
# Outlook works as a public client (PKCE) with only a client ID; the secret is optional.
PEBBLE_MICROSOFT_CLIENT_ID=
PEBBLE_MICROSOFT_CLIENT_SECRET=
